# Required in production. Generate a long random value.
SESSION_SECRET=replace-with-a-long-random-secret

# Set to the exact trusted reverse-proxy hop count or address.
# Leave unset when clients connect directly to Node.
TRUST_PROXY=1

NODE_ENV=production

# Laravel MySQL API (single source of truth for POS + web inventory/sales)
LARAVEL_URL=http://127.0.0.1:8000
# Set to 0 to fall back to local JSON data store
# LARAVEL_SOT=0

# Local 80mm receipt agent. Run on the office PC with the printer.
# Hosted Laravel pushes each sale over Reverb WebSocket; on start and
# on admin login the agent also prints any still-queued receipts.
# RECEIPT_AUTO_PRINT=1
# RECEIPT_API_BASE=https://YOUR-HOSTED-API/api
# LARAVEL_URL=https://YOUR-HOSTED-API
# RECEIPT_USERNAME=admin
# RECEIPT_PASSWORD=replace-with-the-shop-admin-password
# REVERB_APP_KEY=from-hosted-backend
# REVERB_HOST=your-reverb-host
# REVERB_PORT=443
# REVERB_SCHEME=https
# Windows office PC (default when RECEIPT_TRANSPORT is unset on win32):
# RECEIPT_TRANSPORT=windows
# RECEIPT_PRINTER=POS80
# Mac USB (local test):
# RECEIPT_TRANSPORT=usb
# RECEIPT_USB_VENDOR=0416
# RECEIPT_USB_PRODUCT=5011
# Optional LAN webhook fallback (same secret as backend):
# RECEIPT_PRINT_WEBHOOK_SECRET=replace-with-the-backend-secret
# Bluetooth opt-in:
# RECEIPT_TRANSPORT=bluetooth
# RECEIPT_BT_PORT=/dev/cu.ZJ80UEB
