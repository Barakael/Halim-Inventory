# Required in production. Generate a long random value.
SESSION_SECRET=replace-with-a-long-random-secret

# Set to the exact trusted reverse-proxy hop count or address.
# Leave unset when clients connect directly to Node.
TRUST_PROXY=1

NODE_ENV=production

# Laravel MySQL API (single source of truth for POS + web inventory/sales)
LARAVEL_URL=http://127.0.0.1:8000
# Set to 0 to fall back to local JSON data store
# LARAVEL_SOT=0
