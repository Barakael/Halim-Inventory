<?xml version="1.0" encoding="utf-8"?>
<!--
  Default: no cleartext (HTTPS only).
  Explicit LAN hosts used for on-prem Laravel may use HTTP.
  When the API moves to a public HTTPS host, remove the cleartext domain entries.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.1.21</domain>
        <domain includeSubdomains="true">192.168.1.28</domain>
    </domain-config>
</network-security-config>
